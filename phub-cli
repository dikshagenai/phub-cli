    echo -e "    phub-cli -o ~/Downloads \"4k\"        # Download videos into ~/Downloads"
    echo ""
}

configure_filters() {
    while true; do
        clear
        local f_choice
        f_choice=$(search_filter_menu "$SEARCH_SORT" "$SEARCH_DUR")
        case "$f_choice" in
            1)
                local s_choice
                s_choice=$(sort_select_menu)
                case "$s_choice" in
                    1) SEARCH_SORT="relevance" ;;
                    2) SEARCH_SORT="recent" ;;
                    3) SEARCH_SORT="views" ;;
                    4) SEARCH_SORT="rating" ;;
                    5) SEARCH_SORT="longest" ;;
                esac
                ;;
            2)
                local d_choice
                d_choice=$(duration_select_menu)
                case "$d_choice" in
                    1) SEARCH_DUR="all" ;;
                    2) SEARCH_DUR="short" ;;
                    3) SEARCH_DUR="medium" ;;
                    4) SEARCH_DUR="long" ;;
                esac
                ;;
            3)
                SEARCH_SORT="relevance"
                SEARCH_DUR="all"
                ;;
            b|B|"")
                break
                ;;
        esac
    done
}

SEARCH_SORT="relevance"
SEARCH_DUR="all"

# CLI Direct Invocation Argument Handling (ani-cli style)
CLI_SORT=""
CLI_DUR=""
CLI_ACTION=""
CLI_ARG=""
CLI_OUTPUT_DIR=""
CLI_QUERY_PARTS=()

set -- "${ORIGINAL_ARGS[@]}"

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        -v|--version)
            echo "phub-cli v0.5.0"
            exit 0
            ;;
        -p|--play)
            CLI_ACTION="play"
            CLI_ARG="$2"
            shift 2
            ;;
        -f|--feed)
            CLI_ACTION="feed"
            CLI_ARG="${2:-trending}"
            shift 2
            ;;
        -F|--favorites)
            CLI_ACTION="favorites"
            shift
            ;;
        -H|--history)
            CLI_ACTION="history"
            shift
            ;;
        -s|--sort)
            CLI_SORT="$2"
            shift 2
            ;;
        -l|--duration)
            CLI_DUR="$2"
            shift 2
            ;;
        -o|--output-dir)
            CLI_OUTPUT_DIR="$2"
            shift 2
            ;;
        --set-download-dir)
            CLI_ACTION="set_dir"
            CLI_ARG="$2"
            shift 2
            ;;
        -d|--download)
            CLI_ACTION="download"
            if [ -n "$2" ] && [[ "$2" != -* ]]; then
                CLI_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        *)
            CLI_QUERY_PARTS+=("$1")
            shift
            ;;
    esac
done

[ -n "$CLI_OUTPUT_DIR" ] && export PHUBCLI_DOWNLOAD_DIR="$CLI_OUTPUT_DIR"

if [ "$CLI_ACTION" = "set_dir" ]; then
    if [ -n "$CLI_ARG" ]; then
        set_download_dir "$CLI_ARG"
        echo "Download folder set to: $(get_configured_download_dir)"
        if ! is_dir_writable "$CLI_ARG"; then
            echo "Warning: Location is not currently writable. Fallback to ~/Videos/phub-cli will be used if needed."
        fi
        exit 0
    else
        echo "Error: Directory path required for --set-download-dir"
        exit 1
    fi
fi

[ -n "$CLI_SORT" ] && SEARCH_SORT="$CLI_SORT"
[ -n "$CLI_DUR" ] && SEARCH_DUR="$CLI_DUR"

if [ "$CLI_ACTION" = "play" ]; then
    vk="$CLI_ARG"
    if [[ "$vk" =~ viewkey=([a-zA-Z0-9]+) ]]; then
        vk="${BASH_REMATCH[1]}"
    fi
    if [ -n "$vk" ]; then
        play_video "$vk"
        exit $?
    else
        echo "Error: Invalid viewkey or URL."
        exit 1
    fi
elif [ "$CLI_ACTION" = "feed" ]; then
    feed_target="${CLI_ARG:-trending}"
    browse_video_flow "feed" "$feed_target" "Discovery: $feed_target"
    exit 0
elif [ "$CLI_ACTION" = "favorites" ]; then
    browse_video_flow "favorites" "" "Favorites"
    exit 0
elif [ "$CLI_ACTION" = "history" ]; then
    browse_video_flow "history" "" "History"
    exit 0
elif [ "$CLI_ACTION" = "download" ]; then
    dl_q="${CLI_ARG:-${CLI_QUERY_PARTS[*]}}"
    dl_q=$(echo "$dl_q" | xargs)
    if [ -n "$dl_q" ]; then
        set_autodownload_mode "on"
        browse_video_flow "search" "$dl_q" "$dl_q" "$SEARCH_SORT" "$SEARCH_DUR"
        exit 0
    else
        set_autodownload_mode "on"
    fi
elif [ ${#CLI_QUERY_PARTS[@]} -gt 0 ]; then
    direct_query="${CLI_QUERY_PARTS[*]}"
    direct_query=$(echo "$direct_query" | xargs)
    if [ -n "$direct_query" ]; then
        browse_video_flow "search" "$direct_query" "$direct_query" "$SEARCH_SORT" "$SEARCH_DUR"
        exit 0
    fi
fi

# Check for updates in background
check_for_update &
UPDATE_CHECK_PID=$!

while true; do
    # Collect update check result if still running
    if [ -n "$UPDATE_CHECK_PID" ]; then
        wait "$UPDATE_CHECK_PID" 2>/dev/null
        UPDATE_CHECK_PID=""
    fi

    clear
    auto_mode=$(get_autodownload_mode)
    dl_label=$(format_dir_label 18)
    show_home "$auto_mode" "$SEARCH_SORT" "$SEARCH_DUR" "$dl_label"

    read -r -p "Select option: " choice </dev/tty

    case "$choice" in

    # 1. Categories
    1)
        while true; do
            cat_err_tmp=$(mktemp)
            if categories=$(get_categories 2>"$cat_err_tmp") && [ -n "$categories" ]; then
                rm -f "$cat_err_tmp"
                break
            fi
            cat_err=$(cat "$cat_err_tmp" 2>/dev/null)
            rm -f "$cat_err_tmp"

            echo "" > /dev/tty
            echo -e "  ${RED}❌ Failed to fetch categories:${NC}" > /dev/tty
            [ -n "$cat_err" ] && echo -e "  ${ROSE}${cat_err}${NC}" > /dev/tty
            echo "" > /dev/tty
            read -r -p "  Retry fetching categories? (y/n, default: y): " retry_cat </dev/tty
            case "$retry_cat" in
                n|N|q|Q)
                    break 2
                    ;;
                *)
                    continue
                    ;;
            esac
        done

        [ -z "$categories" ] && continue

        category=$(printf '%s\n' "$categories" | fzf "${PHUBCLI_FZF_OPTS[@]}" \
            --prompt="Category ❯ " \
            --height=100% \
            --border \
            --layout=reverse \
            --cycle \
            --delimiter="|" \
            --with-nth=2)

        [ -z "$category" ] && continue

        cid=$(echo "$category" | awk -F'|' '{print $1}')
        cname=$(echo "$category" | awk -F'|' '{print $2}')

        browse_video_flow "category" "$cid" "$cname"
        ;;

    # 2. Search
    2)
        read -r -p "Search query (or '!f' for filters): " query </dev/tty
        query=$(echo "$query" | xargs)
        [ -z "$query" ] && continue

        if [ "$query" = "!f" ] || [ "$query" = "filter" ] || [ "$query" = "filters" ]; then
            configure_filters
            read -r -p "Search query: " query </dev/tty
            query=$(echo "$query" | xargs)
            [ -z "$query" ] && continue
        fi

        browse_video_flow "search" "$query" "$query" "$SEARCH_SORT" "$SEARCH_DUR"
        ;;

    # 3. Discovery Feeds
    3)
        clear
        feed_choice=$(feed_menu)
        case "$feed_choice" in
            1) browse_video_flow "feed" "trending" "Trending" ;;
            2) browse_video_flow "feed" "top_rated" "Top Rated" ;;
            3) browse_video_flow "feed" "most_viewed" "Most Viewed" ;;
            4) browse_video_flow "feed" "most_recent" "Most Recent" ;;
            5) browse_video_flow "feed" "longest" "Longest" ;;
            *) ;;
        esac
        ;;

    # 4. Favorites
    4)
        browse_video_flow "favorites" "" "Favorites"
        ;;

    # 5. Watch History
    5)
        browse_video_flow "history" "" "History"
        ;;

    # 6. Autodownload settings
    6)
        clear
        curr_mode=$(get_autodownload_mode)
        mode_choice=$(autodownload_menu "$curr_mode")
        case "$mode_choice" in
            1) set_autodownload_mode "off" ;;
            2) set_autodownload_mode "on" ;;
            3) set_autodownload_mode "page_mode" ;;
            *) ;;
        esac
        continue
        ;;

    # 7. Download folder settings
    7|dir|folder|p|P)
        while true; do
            clear
            local cfg_dir
            cfg_dir=$(get_configured_download_dir)
            local is_fallback=0
            if ! is_dir_writable "$cfg_dir"; then
                is_fallback=1
            fi
            local active_dir
            active_dir=$(get_download_dir 2>/dev/null)

            local d_choice
            d_choice=$(download_dir_menu "$cfg_dir" "$active_dir" "$is_fallback")
            case "$d_choice" in
                1)
                    change_download_dir_prompt
                    ;;
                2)
                    reset_download_dir
                    clear
                    echo "" > /dev/tty
                    echo -e "  ${GREEN}✅ Reset download folder to default: ${GOLD}~/Videos/phub-cli${NC}" > /dev/tty
                    sleep 1
                    ;;
                b|B|"")
                    break
                    ;;
            esac
        done
        continue
        ;;

    # Search filters configuration
    s|S|8)
        configure_filters
        ;;

    # Update
    u|U)
        clear
        do_update
        ;;

    # Quit
    q|Q)
        clear
        exit 0
        ;;

    *)
        continue
        ;;
    esac
done
