#!/usr/bin/env bash

# Preserve original command-line arguments before redirecting stdin to tty
ORIGINAL_ARGS=("$@")
exec </dev/tty

# Ensure local user bin is in PATH for tools like aria2c
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Resolve script directory (handles symlinks)
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
    SCRIPT="$(readlink "$SCRIPT")"
    [[ "$SCRIPT" != /* ]] && SCRIPT="$SCRIPT_DIR/$SCRIPT"
done
DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"

source "$DIR/modules/config.sh"
source "$DIR/modules/categories.sh"
source "$DIR/modules/player.sh"
source "$DIR/modules/ui.sh"
source "$DIR/modules/updater.sh"
source "$DIR/modules/storage.sh"
source "$DIR/modules/cache.sh"

check_dependencies() {
    local missing=()
    local deps=(fzf mpv yt-dlp curl jq python3)
    for d in "${deps[@]}"; do
        if ! command -v "$d" >/dev/null 2>&1; then
            missing+=("$d")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo ""
        echo "❌ Missing required dependencies: ${missing[*]}"
        echo "   Please install them to use phub-cli."
        exit 1
    fi

    local py_missing=()
    if ! python3 -c "import requests" >/dev/null 2>&1; then
        py_missing+=("requests")
    fi
    if ! python3 -c "import bs4" >/dev/null 2>&1; then
        py_missing+=("beautifulsoup4")
    fi

    if [ ${#py_missing[@]} -gt 0 ]; then
        echo ""
        echo "❌ Missing required Python packages: ${py_missing[*]}"
        echo "   Install them using: pip install ${py_missing[*]}"
        exit 1
    fi
}
check_dependencies

# Prune thumbnail cache in background on startup
prune_thumbnail_cache &

PHUBCLI_FZF_THEME=${PHUBCLI_FZF_THEME:-1}
PHUBCLI_FZF_OPTS=()
if [ "${PHUBCLI_FZF_THEME}" = "1" ]; then
    PHUBCLI_FZF_OPTS=(
        --pointer='❯'
        --marker='❤'
        --prompt='❯ '
        --color='fg:#c0c0c0,bg:-1,hl:#ff005f,fg+:#ffffff,bg+:-1,hl+:#ff5fd7,info:#ffaf00,prompt:#ff5fd7,pointer:#ff005f,marker:#ff5fd7,spinner:#ffaf00,header:#ff5fd7,border:#ff005f'
    )
fi

PHUBCLI_THUMBNAILS=${PHUBCLI_THUMBNAILS:-1}
PHUBCLI_PREVIEW_OPTS=()
if [ "${PHUBCLI_THUMBNAILS}" = "1" ]; then
    PHUBCLI_PREVIEW_OPTS=(
        --preview="\"$DIR/modules/preview.sh\" {}"
        --preview-window="right:58%:wrap,border-left,<85(down:55%:wrap)"
        --bind="ctrl-/:toggle-preview,alt-p:toggle-preview"
    )
else
    PHUBCLI_PREVIEW_OPTS=(
        --preview='echo {} | cut -d"|" -f2'
        --preview-window="down:4:wrap"
    )
fi

prefetch_thumbnails() {
    local vlist="$1"
    [ "${PHUBCLI_THUMBNAILS:-1}" = "0" ] && return
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/phub-cli/thumbnails"
    mkdir -p "$cache_dir" 2>/dev/null
    while IFS='|' read -r vk _ url _; do
        if [ -n "$vk" ] && [ -n "$url" ] && [ ! -s "$cache_dir/${vk}.jpg" ]; then
            curl -s -f -L -m 3 -H "Referer: https://www.pornhub.com/" -o "$cache_dir/${vk}.jpg" "$url" >/dev/null 2>&1 &
        fi
    done <<< "$vlist"
}

# Unified video browsing, pagination, multi-download & playback flow
browse_video_flow() {
    local source_type="$1"
    local source_arg="$2"
    local title_label="$3"
    local search_sort="${4:-}"
    local search_dur="${5:-}"

    local auto_mode
    auto_mode=$(get_autodownload_mode)

    # 1. Page batch download mode (for paginated sources)
    if [ "$auto_mode" = "page_mode" ] && [ "$source_type" != "favorites" ] && [ "$source_type" != "history" ]; then
        clear
        echo "" > /dev/tty
        echo -e "  ${HOT_PINK}📂 Source:${NC} ${GOLD}$title_label${NC}" > /dev/tty
        echo -e "  ${DEEP_PINK}⚡ Mode:${NC} ${PINK}Page Mode (Batch Parallel Download)${NC}" > /dev/tty
        echo "" > /dev/tty

        read -r -p "$(printf '%b' "  ${HOT_PINK}Download videos up to how many pages? (default: 1): ${NC}")" page_count < /dev/tty
        page_count=$(echo "$page_count" | xargs)
        if [ -z "$page_count" ] || ! [[ "$page_count" =~ ^[0-9]+$ ]] || [ "$page_count" -lt 1 ]; then
            page_count=1
        fi
        [ "$page_count" -gt 50 ] && page_count=50

        echo "" > /dev/tty
        local all_videos_tmp
        all_videos_tmp=$(mktemp)
        for ((p=1; p<=page_count; p++)); do
            printf "  ${GOLD}🔍 Fetching page %d/%d...${NC} " "$p" "$page_count" > /dev/tty
            local p_err_tmp
            p_err_tmp=$(mktemp)
            local p_list=""
            local p_exit=0
            case "$source_type" in
                category)
                    p_list=$("$DIR/modules/videos.py" "$source_arg" "$p" 2>"$p_err_tmp")
                    p_exit=$?
                    ;;
                search)
                    p_list=$("$DIR/modules/search.py" --sort "$search_sort" --duration "$search_dur" "$source_arg" "$p" 2>"$p_err_tmp")
                    p_exit=$?
                    ;;
                feed)
                    p_list=$("$DIR/modules/feeds.py" "$source_arg" "$p" 2>"$p_err_tmp")
                    p_exit=$?
                    ;;
            esac
            rm -f "$p_err_tmp"
            if [ "$p_exit" -ne 0 ] || [ -z "$p_list" ]; then
                printf "${ROSE}(no more videos)${NC}\n" > /dev/tty
                break
            fi
            local count
            count=$(echo "$p_list" | grep -c '|')
            printf "${PINK}(%d videos found)${NC}\n" "$count" > /dev/tty
            echo "$p_list" >> "$all_videos_tmp"
        done

        local unique_videos_tmp
        unique_videos_tmp=$(mktemp)
        awk -F'|' '!seen[$1]++' "$all_videos_tmp" > "$unique_videos_tmp"
        local total_vids
        total_vids=$(wc -l < "$unique_videos_tmp" | xargs)
        rm -f "$all_videos_tmp"

        if [ -z "$total_vids" ] || [ "$total_vids" -eq 0 ]; then
            echo "" > /dev/tty
            echo -e "  ${GOLD}ℹ No videos found to download.${NC}" > /dev/tty
            rm -f "$unique_videos_tmp"
            echo "" > /dev/tty
            read -r -p "  Press Enter to return..." _ </dev/tty
            return
        fi

        local dl_dest
        dl_dest=$(get_download_dir)
        echo "" > /dev/tty
        echo -e "  ${GOLD}📋 Total videos found:${NC} ${BOLD}$total_vids${NC}" > /dev/tty
        echo -e "  ${DEEP_PINK}📁 Destination:${NC} $dl_dest" > /dev/tty
        echo -e "  ${PINK}📺 Quality:${NC} 720p" > /dev/tty
        echo -e "  ${HOT_PINK}⚡ Parallel downloads:${NC} 5 concurrent" > /dev/tty
        echo "" > /dev/tty
        read -r -p "$(printf '%b' "  ${HOT_PINK}Continue downloading? (Y/n, default: y): ${NC}")" confirm_dl < /dev/tty
        case "$confirm_dl" in
            n|N|q|Q)
                rm -f "$unique_videos_tmp"
                return
                ;;
            *)
                batch_download_videos "$unique_videos_tmp" "720p"
                rm -f "$unique_videos_tmp"
                echo "" > /dev/tty
                read -r -p "$(printf '%b' "  ${HOT_PINK}Press Enter to return to menu...${NC}")" _ < /dev/tty
                return
                ;;
        esac
    fi

    # 2. Interactive or Multi-select parallel download mode
    local dl_queue
    dl_queue=$(mktemp)
    local page=1
    local nav=""

    while true; do
        local video_list=""
        if [ "$source_type" = "favorites" ]; then
            video_list=$(get_favorites)
        elif [ "$source_type" = "history" ]; then
            video_list=$(get_history)
        else
            while true; do
                local video_err_tmp
                video_err_tmp=$(mktemp)
                case "$source_type" in
                    category)
                        video_list=$("$DIR/modules/videos.py" "$source_arg" "$page" 2>"$video_err_tmp")
                        ;;
                    search)
                        video_list=$("$DIR/modules/search.py" --sort "$search_sort" --duration "$search_dur" "$source_arg" "$page" 2>"$video_err_tmp")
                        ;;
                    feed)
                        video_list=$("$DIR/modules/feeds.py" "$source_arg" "$page" 2>"$video_err_tmp")
                        ;;
                esac
                local video_exit=$?
                local video_err
                video_err=$(cat "$video_err_tmp" 2>/dev/null)
                rm -f "$video_err_tmp"

                if [ "$video_exit" -eq 0 ]; then
                    break
                fi

                echo "" > /dev/tty
                echo -e "  ${RED}❌ Error loading videos:${NC}" > /dev/tty
                if [ -n "$video_err" ]; then
                    echo -e "  ${ROSE}${video_err}${NC}" > /dev/tty
                else
                    echo -e "  ${ROSE}Failed to retrieve video list.${NC}" > /dev/tty
                fi
                echo "" > /dev/tty
                read -r -p "  Retry loading videos? (y/n, default: y): " retry_vid </dev/tty
                case "$retry_vid" in
                    n|N|q|Q)
                        rm -f "$dl_queue"
                        return
                        ;;
                    *)
                        continue
                        ;;
                esac
            done
        fi

        if [ -z "$video_list" ]; then
            echo "" > /dev/tty
            if [ "$source_type" = "favorites" ]; then
                echo -e "  ${GOLD}ℹ No favorites saved yet.${NC}" > /dev/tty
                echo -e "  ${PINK}Tip: Choose any video and select [f] to add it to your favorites!${NC}" > /dev/tty
            elif [ "$source_type" = "history" ]; then
                echo -e "  ${GOLD}ℹ No watch history recorded yet.${NC}" > /dev/tty
                echo -e "  ${PINK}Videos you watch will appear here automatically.${NC}" > /dev/tty
            elif [ "$page" -eq 1 ]; then
                echo -e "  ${GOLD}ℹ No videos found for '${title_label}'.${NC}" > /dev/tty
            else
                echo -e "  ${GOLD}ℹ No more videos found on page $page.${NC}" > /dev/tty
                echo "" > /dev/tty
                read -r -p "  Press Enter to go to previous page..." _ </dev/tty
                ((page--))
                [ "$page" -lt 1 ] && page=1
                continue
            fi
            echo "" > /dev/tty
            read -r -p "  Press Enter to return..." _ </dev/tty
            rm -f "$dl_queue"
            return
        fi

        prefetch_thumbnails "$video_list"

        local nav_options=""
        if [ "$source_type" = "favorites" ]; then
            nav_options="CLEAR_FAV|🗑️  CLEAR ALL FAVORITES"
        elif [ "$source_type" = "history" ]; then
            nav_options="CLEAR_HIST|🗑️  CLEAR WATCH HISTORY"
        else
            [ "$page" -gt 1 ] && nav_options="PREV|<<< Previous page\n"
            nav_options="${nav_options}NEXT|>>> Next page"
        fi

        while true; do
            if [ "$auto_mode" = "on" ]; then
                local queue_count
                queue_count=$(wc -l < "$dl_queue" 2>/dev/null | xargs)
                [ -z "$queue_count" ] && queue_count=0

                local multi_nav=""
                if [ "$queue_count" -gt 0 ]; then
                    multi_nav="DOWNLOAD|⬇️  DOWNLOAD QUEUED VIDEOS ($queue_count queued)\n"
                fi
                if [ "$source_type" != "favorites" ] && [ "$source_type" != "history" ]; then
                    multi_nav="${multi_nav}NEXT|>>> Next page"
                    [ "$page" -gt 1 ] && multi_nav="${multi_nav}\nPREV|<<< Previous page"
                fi

                local multi_prompt="Select videos"
                [ "$queue_count" -gt 0 ] && multi_prompt="Select videos [$queue_count queued]"
                [ "$source_type" != "favorites" ] && [ "$source_type" != "history" ] && multi_prompt="${multi_prompt} (page $page)"
                multi_prompt="${multi_prompt} ❯ "

                local selected_raw
                selected_raw=$(printf "%s\n%b" "$video_list" "$multi_nav" | fzf "${PHUBCLI_FZF_OPTS[@]}" \
                    "${PHUBCLI_PREVIEW_OPTS[@]}" \
                    --multi \
                    --expect=ctrl-n,ctrl-p \
                    --bind="ctrl-a:select-all,ctrl-d:deselect-all" \
                    --header="[TAB] Select | [Ctrl-A] All | [ENTER] Download | [Ctrl-N] Next | [Ctrl-/] Preview" \
                    --prompt="$multi_prompt" \
                    --height=100% \
                    --border \
                    --layout=reverse \
                    --cycle \
                    --delimiter="|" \
                    --with-nth=2)

                local fzf_code=$?
                if [ "$fzf_code" -ne 0 ] || [ -z "$selected_raw" ]; then
                    if [ "$queue_count" -gt 0 ]; then
                        echo "" > /dev/tty
                        read -r -p "  You have $queue_count video(s) queued. Discard queue and exit? (y/n, default: y): " discard_q < /dev/tty
                        case "$discard_q" in
                            n|N) continue ;;
                            *) rm -f "$dl_queue"; return ;;
                        esac
                    else
                        rm -f "$dl_queue"
                        return
                    fi
                fi

                local key_pressed
                key_pressed=$(head -n 1 <<< "$selected_raw")
                local selection_lines
                selection_lines=$(tail -n +2 <<< "$selected_raw")

                if [ "$key_pressed" = "ctrl-n" ] && [ "$source_type" != "favorites" ] && [ "$source_type" != "history" ]; then
                    if [ -n "$selection_lines" ]; then
                        echo "$selection_lines" | grep '|' | grep -vE '^(NEXT|PREV|DOWNLOAD)\|' >> "$dl_queue" || true
                    fi
                    ((page++))
                    break
                fi

                if [ "$key_pressed" = "ctrl-p" ] && [ "$source_type" != "favorites" ] && [ "$source_type" != "history" ]; then
                    if [ -n "$selection_lines" ]; then
                        echo "$selection_lines" | grep '|' | grep -vE '^(NEXT|PREV|DOWNLOAD)\|' >> "$dl_queue" || true
                    fi
                    ((page--))
                    [ "$page" -lt 1 ] && page=1
                    break
                fi

                local has_next
                has_next=$(echo "$selection_lines" | grep -E '^NEXT\|' || true)
                local has_prev
                has_prev=$(echo "$selection_lines" | grep -E '^PREV\|' || true)

                local actual_vids
                actual_vids=$(echo "$selection_lines" | grep '|' | grep -vE '^(NEXT|PREV|DOWNLOAD|CLEAR_FAV|CLEAR_HIST)\|' || true)
                if [ -n "$actual_vids" ]; then
                    echo "$actual_vids" >> "$dl_queue"
                fi

                if [ -n "$has_next" ]; then
                    ((page++))
                    break
                fi

                if [ -n "$has_prev" ]; then
                    ((page--))
                    [ "$page" -lt 1 ] && page=1
                    break
                fi

                confirm_and_run_batch_download "$dl_queue" "720p"
                local res=$?
                case "$res" in
                    0|3)
                        rm -f "$dl_queue"
                        return
                        ;;
                    *)
                        continue
                        ;;
                esac
            fi

            # Standard interactive single-selection
            local prompt_label="${title_label}"
            [ "$source_type" != "favorites" ] && [ "$source_type" != "history" ] && prompt_label="${title_label} (p.$page)"

            local video
            video=$(printf "%s\n%b" "$video_list" "$nav_options" | fzf "${PHUBCLI_FZF_OPTS[@]}" \
                "${PHUBCLI_PREVIEW_OPTS[@]}" \
                --header="[ENTER] Choose Action | [Ctrl-/] Toggle Preview" \
                --prompt="${prompt_label} ❯ " \
                --height=100% \
                --border \
                --layout=reverse \
                --cycle \
                --delimiter="|" \
                --with-nth=2)

            [ -z "$video" ] && { rm -f "$dl_queue"; return; }

            local viewkey title thumb_url duration rating
            IFS='|' read -r viewkey title thumb_url duration rating _ <<< "$video"

            if [ "$viewkey" = "NEXT" ]; then
                ((page++))
                break
            elif [ "$viewkey" = "PREV" ]; then
                ((page--))
                [ "$page" -lt 1 ] && page=1
                break
            elif [ "$viewkey" = "CLEAR_FAV" ]; then
                clear_favorites
                echo "" > /dev/tty
                echo -e "  ${HOT_PINK}🗑️  Favorites cleared!${NC}" > /dev/tty
                sleep 0.8
                break
            elif [ "$viewkey" = "CLEAR_HIST" ]; then
                clear_history
                echo "" > /dev/tty
                echo -e "  ${HOT_PINK}🗑️  Watch history cleared!${NC}" > /dev/tty
                sleep 0.8
                break
            fi

            # Pre-play menu loop
            while true; do
                clear
                local pre_action
                pre_action=$(pre_play_menu "$viewkey")

                case "$pre_action" in
                    1)
                        # Watch video
                        add_history "$viewkey" "$title" "$thumb_url" "$duration" "$rating"
                        while true; do
                            play_video "$viewkey"
                            clear
                            local action
                            action=$(post_play_menu "$viewkey")

                            case "$action" in
                                1)
                                    continue
                                    ;;
                                f|F)
                                    toggle_favorite "$viewkey" "$title" "$thumb_url" "$duration" "$rating"
                                    local fav_res=$?
                                    echo "" > /dev/tty
                                    if [ "$fav_res" -eq 0 ]; then
                                        echo -e "  ${HOT_PINK}❤️  Added to Favorites!${NC}" > /dev/tty
                                    else
                                        echo -e "  ${ROSE}💔 Removed from Favorites!${NC}" > /dev/tty
                                    fi
                                    sleep 0.8
                                    continue
                                    ;;
                                2)
                                    break 2
                                    ;;
                                3)
                                    nav="home"
                                    break 2
                                    ;;
                                q|Q)
                                    clear
                                    exit 0
                                    ;;
                                *)
                                    continue
                                    ;;
                            esac
                        done
                        break
                        ;;
                    2)
                        # Download video
                        while true; do
                            clear
                            local quality
                            quality=$(quality_menu)

                            case "$quality" in
                                1|2|3|4)
                                    if download_video "$viewkey" "$quality"; then
                                        clear
                                        local dl_action
                                        dl_action=$(post_download_menu)

                                        case "$dl_action" in
                                            1) continue ;;
                                            2) break 2 ;;
                                            3) nav="home"; break 2 ;;
                                            q|Q) clear; exit 0 ;;
                                            *) continue ;;
                                        esac
                                    else
                                        break
                                    fi
                                    ;;
                                b|B) break ;;
                                *) continue ;;
                            esac
                        done
                        continue
                        ;;
                    3)
                        # Open in browser
                        open_in_browser "$viewkey"
                        continue
                        ;;
                    f|F)
                        toggle_favorite "$viewkey" "$title" "$thumb_url" "$duration" "$rating"
                        local fav_res=$?
                        echo "" > /dev/tty
                        if [ "$fav_res" -eq 0 ]; then
                            echo -e "  ${HOT_PINK}❤️  Added to Favorites!${NC}" > /dev/tty
                        else
                            echo -e "  ${ROSE}💔 Removed from Favorites!${NC}" > /dev/tty
                        fi
                        sleep 0.8
                        if [ "$source_type" = "favorites" ]; then
                            break 2 # refresh favorites list
                        fi
                        continue
                        ;;
                    b|B)
                        break
                        ;;
                    *)
                        continue
                        ;;
                esac
            done

            if [ "$nav" = "home" ]; then
                nav=""
                rm -f "$dl_queue"
                return
            fi

            if [ "$source_type" = "favorites" ] && ! is_favorite "$viewkey"; then
                # If removed while browsing favorites, reload list
                break
            fi
        done
    done
    rm -f "$dl_queue"
}

print_help() {
    echo ""
    echo -e "  ${BOLD_RED}phub-cli${NC} - terminal video browser & downloader"
    echo ""
    echo -e "  ${HOT_PINK}Usage:${NC}"
    echo -e "    phub-cli [OPTIONS] [QUERY]"
    echo ""
    echo -e "  ${HOT_PINK}Options:${NC}"
    echo -e "    ${GOLD}-d, --download [QUERY]${NC}      Search and batch download videos"
    echo -e "    ${GOLD}-o, --output-dir <DIR>${NC}     Set download destination folder (with auto-fallback)"
    echo -e "    ${GOLD}--set-download-dir <DIR>${NC}   Permanently configure download folder"
    echo -e "    ${GOLD}-p, --play <KEY|URL>${NC}        Directly play video by viewkey or Pornhub URL"
    echo -e "    ${GOLD}-f, --feed <NAME>${NC}           Browse discovery feed: trending, top, views, recent, longest"
    echo -e "    ${GOLD}-F, --favorites${NC}             Open Favorites collection"
    echo -e "    ${GOLD}-H, --history${NC}               Open Watch History"
    echo -e "    ${GOLD}-s, --sort <ORDER>${NC}          Sort order: relevance, recent, views, rating, longest"
    echo -e "    ${GOLD}-l, --duration <DUR>${NC}        Duration filter: all, short, medium, long"
    echo -e "    ${GOLD}-v, --version${NC}               Display version"
    echo -e "    ${GOLD}-h, --help${NC}                  Display this help message"
    echo ""
    echo -e "  ${HOT_PINK}Examples:${NC}"
    echo -e "    phub-cli \"goth girl\"              # Search and browse interactively"
    echo -e "    phub-cli -s views \"cosplay\"         # Search sorted by most viewed"
    echo -e "    phub-cli -f trending                # Browse trending feed"
